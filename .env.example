# --- Pengaturan PPDB (nilai bawaan) ---
# Keempat nilai ini hanya dipakai selama panitia belum menyimpan apa pun di
# Panel Admin > Pengaturan PPDB. Setelah disimpan, isi database yang menang
# dan mengubah nilai di sini tidak lagi berpengaruh.
PPDB_OPEN=true
PPDB_YEAR="2026/2027"
PPDB_OPENS_AT="2026-01-05"
PPDB_CLOSES_AT="2026-06-30"
